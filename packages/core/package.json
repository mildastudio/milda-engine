{
  "name": "@mildastudio/core",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mildastudio/milda-engine.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@mildastudio/milda": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
